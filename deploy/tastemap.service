[Unit]
Description=TasteMap FastAPI server
After=network.target

[Service]
Type=simple
# setup.sh overwrites this line with whatever user actually ran it
# (opc on Oracle Linux, ubuntu on Canonical images) — 'ubuntu' here is just
# the checked-in default if this file is ever installed by hand instead.
User=ubuntu
WorkingDirectory=/opt/tastemap
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tastemap/.venv/bin/uvicorn api.server:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
