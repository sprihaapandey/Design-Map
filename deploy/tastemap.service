[Unit]
Description=TasteMap FastAPI server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tastemap
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tastemap/.venv/bin/uvicorn api.server:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
